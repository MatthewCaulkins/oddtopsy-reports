# PostgreSQL
DATABASE_URL=postgresql://oddtopsy:replace-me@postgres:5432/oddtopsy_reports
# Local Postgres container (read by docker compose; keep in sync with DATABASE_URL)
POSTGRES_DB=oddtopsy_reports
POSTGRES_USER=oddtopsy
POSTGRES_PASSWORD=replace-me

# Payload
PAYLOAD_SECRET=replace-me

# Application
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# Sign-in methods: password (local default), cognito (production), or password,cognito.
# Production values are listed in docs/deployment.md.
AUTH_PROVIDERS=password
# Only needed when AUTH_PROVIDERS includes cognito:
# COGNITO_REGION=us-east-1
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# COGNITO_CLIENT_SECRET=
# COGNITO_DOMAIN=https://auth.oddtopsies.org

# Features. Subscriptions are not built yet: leave off to hide Subscribe and 404 /subscribe.
SUBSCRIPTIONS_ENABLED=false

# Storage
S3_ENABLED=false
S3_BUCKET=
AWS_REGION=us-east-1

# Email (Amazon SES). Leave EMAIL_FROM_ADDRESS empty to print emails to the console.
# The from address must be a verified SES identity.
EMAIL_FROM_ADDRESS=editorial@oddtopsies.org
EMAIL_FROM_NAME=Oddtopsy Reports
SES_REGION=us-east-1

# Initial administrator
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-me