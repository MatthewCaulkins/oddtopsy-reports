# PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/oddtopsy_reports

# Payload
PAYLOAD_SECRET=replace-me

# Application
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# Storage
S3_ENABLED=false
S3_BUCKET=
AWS_REGION=us-east-1

# Email (Amazon SES). Leave EMAIL_FROM_ADDRESS empty to print emails to the console.
# The from address must be a verified SES identity.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Oddtopsy Reports
SES_REGION=us-east-1

# Initial administrator
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-me